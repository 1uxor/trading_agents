# MT5 credentials (demo account)
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Live trading (disabled by default — requires UI confirmation too)
LIVE_TRADING=false

# LLM API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# HuggingFace
HF_TOKEN=

# Database
DATABASE_URL=sqlite+aiosqlite:///./trading_agents.db

# Risk defaults
MAX_RISK_PER_TRADE_PCT=1.0
MAX_OPEN_POSITIONS_PER_AGENT=3
MAX_OPEN_POSITIONS_GLOBAL=10
MAX_DAILY_LOSS_PCT=5.0
MAX_LOT_SIZE=1.0

# Server
HOST=0.0.0.0
PORT=8000
